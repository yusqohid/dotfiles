/*****----- Configuration -----*****/
configuration {
    show-icons: false;
}

/*****----- Global Properties -----*****/
* {
    font:                        "JetBrains Mono Nerd Font 10";

    background:                  #101010;   /* base */
    background-alt:              #252525;   /* surface0 */
    foreground:                  #ffffff;   /* text */

    selected:                    #89b482;   /* green */
    active:                      #6d8dad;   /* blue */
    urgent:                      #ec6b64;   /* red */
}

/*
USE_ICON=NO
*/

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       900px;

    border-radius:               20px;

    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    spacing:                     15px;
    padding:                     30px;
    background-color:            transparent;
    orientation:                 horizontal;
    children:                    [ "imagebox", "listview" ];
}

/*****----- Imagebox -----*****/
imagebox {
    border-radius:               20px;
    background-color:            transparent;
    background-image:            url("~/.config/rofi/images/g.png", height);
    children:                    [ "dummy", "inputbar", "dummy" ];
}

/*****----- Inputbar -----*****/
inputbar {
    spacing:                     15px;
    background-color:            transparent;
    text-color:                  #c7b89d;
    children:                    [ "dummy", "textbox-prompt-colon", "entry", "dummy"];
}

dummy {
    background-color: transparent;
}

textbox-prompt-colon {
    expand:                      false;
    str:                         "";
    padding:                     10px 13px;
    border-radius:               15px;

    background-color:            #ec6b64; /* red */
    text-color:                  #1e2122;
}

prompt {
    padding:                     10px;
    border-radius:               15px;

    background-color:            #6d8dad; /* blue */
    text-color:                  #1e2122;
}

/*****----- Message -----*****/
message {
    padding:                     10px;
    border-radius:               10px;

    background-color:            #282b2c; /* surface0 */
    text-color:                  #c7b89d;
}

textbox {
    background-color:            inherit;
    text-color:                  inherit;
}

/*****----- Listview -----*****/
listview {
    columns:                     6;
    lines:                       1;
    cycle:                       true;
    scrollbar:                   false;

    spacing:                     5px;
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    padding:                     10px;
    border-radius:               15px;

    background-color:            transparent;
    text-color:                  #c7b89d;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

/* Normal */
element normal.normal,
element alternate.normal {
    background-color: #1e2122;
    text-color: #c7b89d;
}

/* Hover / Selected */
element selected.normal {
    background-color: #89b482; /* green */
    text-color: #1e2122;
}

/* Active */
element normal.active,
element alternate.active {
    background-color: #6d8dad; /* blue */
    text-color: #1e2122;
}

/* Urgent */
element normal.urgent,
element alternate.urgent {
    background-color: #ec6b64; /* red */
    text-color: #1e2122;
}
